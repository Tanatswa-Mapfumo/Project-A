# --- App ---
APP_ENV=development
APP_NAME=Adaptive Fitness Coach API
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://fitness:fitness@localhost:5432/fitness
DATABASE_URL_SYNC=postgresql+psycopg://fitness:fitness@localhost:5432/fitness

# --- Auth (supabase | mock) ---
# Use "supabase" in staging/production. "mock" is for local dev/tests only.
AUTH_MODE=mock
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REQUIRE_EMAIL_CONFIRM=false
# Dev-only secret used to sign JWTs in mock auth mode. Change it outside of tests.
MOCK_JWT_SECRET=dev-only-secret-change-me-0123456789

# --- AI ---
AI_PROVIDER=mock
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=2.5

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# --- Misc ---
LOG_LEVEL=INFO
ENABLE_DOCS=true
